# 이 파일을 .env 로 복사한 뒤 본인 경로로 수정.
# .env 는 .gitignore 에 등록되어 있어 절대 커밋되지 않음.

# === 필수 ===
# 분봉 corpus 폴더 (1분봉 CSV 들이 있는 곳)
FIBTRADER_CORPUS_DIR=C:\Users\mwk94\mw94\data\cache\1m_massive

# === 선택 ===
# 학습 산출물 저장 폴더 (모델/oof/notebook/insight 등)
# 미지정 시 ./data/artifacts 사용 (gitignore 됨)
FIBTRADER_ARTIFACTS_DIR=C:\Users\mwk94\mw94\data\artifacts

# 전체 데이터 루트 (위 둘 안 정하면 이거 기준)
# FIBTRADER_DATA_DIR=C:\Users\mwk94\mw94\data
